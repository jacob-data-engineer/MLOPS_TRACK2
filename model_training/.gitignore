# CodeBuild source zips — regenerated from the .py/Dockerfile sources,
# which are what's actually committed. terraform/platform/{codebuild.tf,
# codebuild_pipeline.tf} read these directly off disk from here.
*.zip

# Local checkpoint downloads (register_baseline_model.py pulls these
# into src/ before uploading to S3/the Model Registry) -- large binaries
# that don't belong in git history, not source. yolov8n.pt/
# yolov8n-baseline.tar.gz predate this rule and stay tracked as-is; this
# just stops the newer yolo11* ones (and any future size) from being
# added.
*.pt
*-baseline.tar.gz

# Local Python env / build cache
.venv/
__pycache__/
*.pyc
