<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="Resource Catalog" id="resource-catalog">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== COLUMN HEADERS ===== -->
        <mxCell id="h1" value="Pipeline &amp; Model Registry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="h2" value="Lambdas (Track2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="h3" value="CodeBuild &amp; SNS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="h4" value="Inference Endpoints" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="40" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="h5" value="S3 Buckets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="40" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="h6" value="Other" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1640" y="40" width="280" height="36" as="geometry" /></mxCell>

        <!-- ===== COLUMN 1: Pipeline & Model Registry ===== -->
        <mxCell id="c1i1" value="&lt;b&gt;track2-yolo-training-pipeline&lt;/b&gt;&lt;br&gt;SageMaker Pipeline. Orchestrates every training run: TrainYolo -&amp;gt; EvaluateYolo -&amp;gt; RegisterYoloModel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c1i2" value="&lt;b&gt;track2-yolo11&lt;/b&gt; (Model Registry)&lt;br&gt;Model Package Group holding every trained candidate (v1-v9). Tracks approval status, metrics, and model artifact location." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="280" height="110" as="geometry" /></mxCell>

        <!-- ===== COLUMN 2: Lambdas ===== -->
        <mxCell id="c2i1" value="&lt;b&gt;track2-sagemaker-pull-training&lt;/b&gt;&lt;br&gt;Auto-triggered by an S3 event on latest.json. Refreshes the training-ready data folder from the newest completed external data pull." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="96" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c2i2" value="&lt;b&gt;track2-yolo-training-completed-notify&lt;/b&gt;&lt;br&gt;Triggered on pipeline execution status change (Executing/Succeeded/Failed/Stopped). Emails stakeholders each time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="226" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c2i3" value="&lt;b&gt;track2-yolo-dump-approved-weights&lt;/b&gt;&lt;br&gt;Triggered when a model package is Approved. Archives the approved weights to a stable S3 location and emails reviewers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="356" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c2i4" value="&lt;b&gt;track2-yolo-confidence-monitor&lt;/b&gt;&lt;br&gt;Monitors live endpoint prediction confidence over time, watching for model drift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="486" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="c2i5" value="&lt;b&gt;track2-yolo-trigger-review&lt;/b&gt;&lt;br&gt;Triggered by drift-monitor SNS alerts. Notifies reviewers that a candidate needs human attention." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="596" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="c2i6" value="&lt;b&gt;track2-yolo-weekly-retrain&lt;/b&gt;&lt;br&gt;EventBridge schedule, every Sunday 23:00 Asia/Singapore. Automatically starts a new pipeline execution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="706" width="280" height="90" as="geometry" /></mxCell>

        <!-- ===== COLUMN 3: CodeBuild + SNS ===== -->
        <mxCell id="c3i1" value="&lt;b&gt;CodeBuild: track2-yolo-train-images&lt;/b&gt;&lt;br&gt;Builds and pushes the training/serving Docker image to ECR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="96" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="c3i2" value="&lt;b&gt;CodeBuild: track2-yolo-run-pipeline&lt;/b&gt;&lt;br&gt;Runs run_pipeline.py entirely on AWS, not a local machine. The mechanism used for every manual/CLI-triggered run this session." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="206" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c3i3" value="&lt;b&gt;SNS: track2-yolo-reviewer-notifications&lt;/b&gt;&lt;br&gt;General notification topic (training complete, weights archived). Has a confirmed email subscriber." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="336" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="c3i4" value="&lt;b&gt;SNS: track2-yolo-monitor-drift&lt;/b&gt;&lt;br&gt;Drift alert topic, feeds into trigger_review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="456" width="280" height="80" as="geometry" /></mxCell>

        <!-- ===== COLUMN 4: Endpoints ===== -->
        <mxCell id="c4i1" value="&lt;b&gt;track2-yolo-endpoint&lt;/b&gt;&lt;br&gt;[ NOT DEPLOYED — currently deleted, endpoint and backing Model both gone ]. Was the Async Inference endpoint serving YOLO11 hazard detection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="96" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="c4i2" value="&lt;b&gt;jurong-port-swinir-endpoint-jl&lt;/b&gt;&lt;br&gt;InService, but backing Model resource was deleted — next invocation will fail. SwinIR image restoration (JURONG PORT project)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="236" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c4i3" value="&lt;b&gt;jurong-port-instructir-endpoint-jl&lt;/b&gt;&lt;br&gt;InService, same broken-Model issue as SwinIR. InstructIR image restoration (JURONG PORT project)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="366" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="c4i4" value="&lt;b&gt;real-esrgan-endpoint-jl&lt;/b&gt;&lt;br&gt;InService and healthy. Real-ESRGAN super-resolution, from the separate real-esrgan-sagemaker project." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="486" width="280" height="100" as="geometry" /></mxCell>

        <!-- ===== COLUMN 5: S3 Buckets ===== -->
        <mxCell id="c5i1" value="&lt;b&gt;track2-s3&lt;/b&gt;&lt;br&gt;Main pipeline bucket. Training data, run outputs, approved-weights archive, dataset. Terraform-managed, versioned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="96" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="c5i2" value="&lt;b&gt;sagemaker-ap-southeast-1-125192671932&lt;/b&gt;&lt;br&gt;SageMaker's auto-created default bucket. Held evaluation.json for versions 1-7 before the fix redirected new runs to track2-s3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="216" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="c5i3" value="&lt;b&gt;gp-jurong-port-s3-jl&lt;/b&gt;&lt;br&gt;JURONG PORT's shared bucket: SwinIR/InstructIR/Real-ESRGAN artifacts, plus Track2's original yolo11s-demo base model source. No versioning enabled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="346" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="c5i4" value="&lt;b&gt;safety-model-dataset-dev&lt;/b&gt;&lt;br&gt;True upstream source of all real hazard training images. Used by both the real pipeline and the dummy seed script." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="486" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="c5i5" value="&lt;b&gt;snaic-jp-terraform-state-125192671932&lt;/b&gt;&lt;br&gt;Remote Terraform state backend for the separate Track2_tmp and track2-jlma stacks. Unrelated to this pipeline; backed up (not deleted) this session." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="606" width="280" height="120" as="geometry" /></mxCell>

        <!-- ===== COLUMN 6: Other ===== -->
        <mxCell id="c6i1" value="&lt;b&gt;Studio Domain d-l02rcksuzieb&lt;/b&gt;&lt;br&gt;SageMaker Studio (IAM auth mode). Used to view the Model Registry outside Unified Studio's broken Model Hub." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1640" y="96" width="280" height="100" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
