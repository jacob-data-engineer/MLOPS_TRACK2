# Local values matching what is ACTUALLY deployed, reconstructed from the
# live account (the original tfvars was never in this repo -- state and
# vars lived on another machine under c:\SNAIC\terraformer_track_2).
#
# review_app_public: the live security group's own rule description reads
# "review app, OPEN TO THE INTERNET (review_app_public=true, no auth of
# its own)" -- that string is generated by ec2.tf's conditional, so the
# stack was applied with this true. Set here to MATCH reality, not to
# change it: leaving it at the false default would make terraform want to
# restrict the group to operator_ips and lock everyone out.
review_app_public = true

# Ignored entirely while review_app_public is true (ec2.tf:74 picks the
# 0.0.0.0/0 branch), and the original list is not recoverable from the
# live group for that same reason -- the deployed rule holds 0.0.0.0/0,
# not anyone's IP. Repopulate this before ever flipping review_app_public
# back to false, or the security group ends up with an empty CIDR list.
operator_ips = []
